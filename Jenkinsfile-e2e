pipeline {
    agent { label 'worker' }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        REPO_NAME = sh(returnStdout: true, script: 'basename `git remote get-url origin` .git').trim()
        VERSION = sh(returnStdout: true, script: 'uv version --short').trim()
        LATEST_AUTHOR = sh(returnStdout: true, script: 'git show -s --pretty=%an').trim()
        LATEST_COMMIT_ID = sh(returnStdout: true, script: 'git describe --tags --long  --always').trim()
        MAIN_BRANCH_REGEX = /(^main$)/
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    echo REPO_NAME
                    echo LATEST_AUTHOR
                    echo LATEST_COMMIT_ID
                    echo VERSION

                    echo env.BUILD_NUMBER
                    echo env.TAG_NAME
                }
                script {
                    sh 'uv sync --locked --all-groups'
                    sh 'hurl --version'
                }
            }
        }

        stage('End-to-End HURL Test') {
            environment {
                HURL_VARIABLE_BASE_URL="https://api.heigit.org/ohsome-api-staging/v2"
                HURL_VARIABLE_SWAGGER_UI_CSS_URL="https://ohsome.org/static/swagger-ui.css"
                HURL_VARIABLE_SWAGGER_UI_JS_URL="https://ohsome.org/static/swagger-ui-bundle.js"
            }
            steps {
                script {
                    withCredentials([string(credentialsId: 'heigit-api-prod-key', variable: 'HURL_SECRET_API_KEY')]) {
                        sh 'hurl --delay 12000 --test tests-end-to-end/*.hurl'
                    }
                }
            }
            post {
               failure {
                  rocket_basicsend("End-to-End Tests on *${REPO_NAME}*-build nr. ${env.BUILD_NUMBER} on Branch - ${env.BRANCH_NAME}  (<${env.BUILD_URL}|Open Build in Jenkins>) were *unsuccessful*. Latest commit from  ${LATEST_AUTHOR}.")
               }
            }
        }

        stage('End-to-End Schemathesis Test') {
            environment {
                VIRTUAL_ENV="${WORKSPACE}/.venv"
                PATH="${VIRTUAL_ENV}/bin:${PATH}"
                OPENAPI_URL="https://api.heigit.org/ohsome-api-staging/v2/openapi.json"
            }
            steps {
                script {
                    withCredentials([string(credentialsId: 'heigit-api-prod-key', variable: 'API_KEY')]) {
                        sh 'schemathesis \
                            run \
                            --rate-limit "9/m" \
                            --phases examples \
                            --exclude-checks ignored_auth,positive_data_acceptance \
                            --header "authorization: $API_KEY" \
                            $OPENAPI_URL'
                    }
                }
            }
            post {
               failure {
                  rocket_basicsend("End-to-End Tests on *${REPO_NAME}*-build nr. ${env.BUILD_NUMBER} on Branch - ${env.BRANCH_NAME}  (<${env.BUILD_URL}|Open Build in Jenkins>) were *unsuccessful*. Latest commit from  ${LATEST_AUTHOR}.")
               }
            }
        }

        stage('End-to-End Docs Example Test') {
            environment {
                VIRTUAL_ENV="${WORKSPACE}/.venv"
                PATH="${VIRTUAL_ENV}/bin:${PATH}"
                OHSOME_API_URL="https://api.heigit.org/ohsome-api-staging/v2"
            }
            steps {
                script {
                    withCredentials([string(credentialsId: 'heigit-api-prod-key', variable: 'OHSOME_API_KEY')]) {
                        sh 'pytest --maxfail=1 docs/source/how-to-guides/examples/'
                    }
                }
            }
            post {
               failure {
                  rocket_basicsend("End-to-End Tests on *${REPO_NAME}*-build nr. ${env.BUILD_NUMBER} on Branch - ${env.BRANCH_NAME}  (<${env.BUILD_URL}|Open Build in Jenkins>) were *unsuccessful*. Latest commit from  ${LATEST_AUTHOR}.")
               }
            }
        }
    }
}
