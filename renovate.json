{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"packageRules": [
		{
			"description": "Automerge dev dependencies",
			"matchDepTypes": ["devDependencies"],
			"automerge": true
		},
		{
			"description": "Automerge minor and patch dependencies excluding 0.x versions",
			"matchUpdateTypes": ["minor", "patch"],
			"matchCurrentVersion": "!/^0/",
			"automerge": true
		}
	],
	"pre-commit": {
		"enabled": true
	},
	"minimumReleaseAge": "1 week",
	"description": "Schedule daily before 9 AM",
	"schedule": ["* 0-9 * * *"]
}
